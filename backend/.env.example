# Copia este archivo como ".env" y pon tus datos reales (el .env NO se sube a GitHub)
PORT=3001

# --- Supabase (Postgres) ---
# Supabase -> botón "Connect" -> "Session pooler" -> copia la URI y cambia [YOUR-PASSWORD] por tu contraseña.
# (Si la contraseña tiene símbolos como @ # / : ?, escríbelos codificados: @ = %40, # = %23, / = %2F)
# Ejemplo:
# DATABASE_URL=postgresql://postgres.abcdefghijkl:TuPassword@aws-0-us-east-1.pooler.supabase.com:5432/postgres
#
# --- Postgres local (para desarrollo en tu PC) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_parking
