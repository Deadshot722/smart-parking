{
  "name": "smart-parking-backend",
  "version": "2.0.0",
  "description": "API de Smart-Parking (Express + PostgreSQL/Supabase): usuarios, estacionamientos, cajones, boletos, pagos y caseta + servicio gRPC (llamadas a procedimientos remotos)",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node seed.js",
    "rpc:servidor": "node grpc/servidor.js",
    "rpc:demo": "node grpc/demo.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.5",
    "@grpc/proto-loader": "^0.7.13",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "pg": "^8.13.1"
  }
}
